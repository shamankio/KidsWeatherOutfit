<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KidsWeatherOutfit" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Shown by the system while the process starts; handed over to Theme.KidsWeatherOutfit by installSplashScreen(). -->
    <style name="Theme.KidsWeatherOutfit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KidsWeatherOutfit</item>
    </style>
</resources>
